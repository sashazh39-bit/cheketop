_NAME_TOKEN_RE = re.compile(r"[A-Za-zА-ЯЁа-яё]+\.?")


def _is_bank_token(tok: str) -> bool:
    key = _norm_token(tok)
    if key in ALIASES:
        return True
    # «яндекс», «рос», «банк» и т.п. — которые входят в состав многословных
    # алиасов, но сами по себе не идентифицируют банк, всё равно не должны
    # попасть в имя.
    bank_fragments = {"банк", "bank", "яндекс", "yandex", "рос", "ros",
                      "хоум", "home", "home-credit", "сити", "citi",
                      "альфа", "сбер", "газпром", "почта", "озон", "ozon",
                      "мтс", "mts", "втб", "vtb", "псб", "psb", "бкс", "bcs",
                      "ренессанс", "renaissance", "открытие", "otkritie",
                      "райф", "раиф", "raif", "авангард", "avangard",
                      "совком", "sovcom", "халва", "тинькофф", "tinkoff",
                      "тбанк", "tbank", "рсхб", "rshb", "рнкб", "rnkb",
                      "убрир", "ubrir", "бсп", "bspb", "спб"}
    return key in bank_fragments


def parse_name(text: str) -> Optional[str]:
    """
    Извлекает «похожее на имя» из свободного текста. Не пытается
    склонять в именительный падеж (это требует pymorphy и выходит за рамки
    модуля) — возвращает как есть: «Пете», «Ивану Иванову», «Сергею П.».

    Алгоритм:
      1. выкинуть телефоны, числа, валюту;
      2. токенизировать, отфильтровать стоп-слова и алиасы банков;
      3. из оставшихся токенов собрать максимальную последовательность
         кириллических слов (имя-отчество-фамилия, инициалы);
      4. предпочесть последовательность, стоящую в тексте раньше алиаса банка,
         чтобы в «Пете в тбанк» выделилось «Пете», а не «тбанк».
    """
    # 1. выкинуть телефоны и числа/валюту
    clean = _strip_phones(text)
    clean = _RE_AMOUNT_UNIT.sub(" ", clean)
    clean = _RE_AMOUNT_WITH_CUR.sub(" ", clean)
    clean = re.sub(r"\d+", " ", clean)
    clean = re.sub(r"[₽$€]", " ", clean)

    # 2. также заранее вырежем многословные алиасы (чтобы «банк санкт-петербург»
    #    не распался на токены «Санкт-Петербург», которые похожи на имя).
    low = clean.lower().replace("ё", "е")
    for alias, _ in _MULTIWORD_ALIASES:
        if alias and alias in low:
            # вырезаем алиас из исходной строки по индексам из low
            idx = low.find(alias)
            while idx != -1:
                clean = clean[:idx] + " " * len(alias) + clean[idx + len(alias):]
                low = low[:idx] + " " * len(alias) + low[idx + len(alias):]
                idx = low.find(alias, idx + len(alias))

    # 3. токенизируем — слова + инициалы (И.)
    tokens = _NAME_TOKEN_RE.findall(clean)

    # Собираем максимальные последовательности кандидатов — используем
    # оригинальный регистр для вывода.
    runs: list[list[str]] = []
    current: list[str] = []
    for tok in tokens:
        key = _norm_token(tok)
        # Инициал: одна буква. Чтобы не спутать с предлогами («в», «к», «с»),
        # считаем инициалом только если токен заканчивается точкой ИЛИ
        # начинается с прописной буквы (в исходном вводе).
        bare = key.rstrip(".")
        is_initial = (
            len(bare) == 1
            and (tok.endswith(".") or (tok[:1].isalpha() and tok[:1].isupper()))
        )
        is_cyrillic = bool(re.fullmatch(r"[А-ЯЁа-яё]+\.?", tok))

        if is_initial and current:
            # Однобуквенные предлоги/союзы без точки («в», «к», «с», «и», «у»)
            # не могут быть инициалом, даже если ошибочно написаны с заглавной.
            # Точка на конце — явный сигнал инициала, тогда стоп-лист игнорируем.
            if not tok.endswith(".") and bare in {"в", "к", "с", "у", "о",
                                                  "и", "а", "я"}:
                runs.append(current)
                current = []
                continue
            current.append(tok if tok.endswith(".") else tok + ".")
            continue

        # имя обязано быть кириллическим (латиница — скорее название банка).
        if not is_cyrillic:
            if current:
                runs.append(current)
                current = []
            continue

        if key in _STOP_WORDS or _is_bank_token(tok) or len(key) < 2:
            if current:
                runs.append(current)
                current = []
            continue

        current.append(tok)

    if current:
        runs.append(current)

    if not runs:
        return None

    # 4. Выбираем лучший run: предпочитаем длиной 1..3 токена, стоящий в тексте
    #    раньше (обычно получатель упоминается до банка).
    def _score(run: list[str]) -> tuple:
        # отрицательная позиция в тексте → раньше → лучше; затем длина 1..3;
        # «настоящие» имена начинаются с заглавной — дадим им бонус.
        first = run[0]
        pos = text.find(first)
        cap_bonus = 1 if first[:1].isupper() else 0
        length_bonus = 1 if 1 <= len(run) <= 3 else 0
        return (cap_bonus + length_bonus, -pos if pos >= 0 else -10**9, -len(run))

    best = max(runs, key=_score)
    return " ".join(best[:3])


# ──────────────────────────────────────────────────────────────────────────────
# 4. ПАРСЕР БАНКА
# ──────────────────────────────────────────────────────────────────────────────
def detect_bank(text: str) -> Tuple[Optional[str], float]:
    """
    Возвращает (канон_банк, качество) — 0.0..1.0.
      1.0  — точный многословный алиас («банк санкт-петербург», «озон банк»)
      0.9  — точный однословный алиас, уникальный и длиной ≥3 букв
      0.7  — короткий однословный алиас (≤2 букв: «сб», «тб», «пб»)
      0.5  — substring-матч в составном слове
      0.0  — не распознан
    """
    if not text:
        return None, 0.0
    low = _norm_token(text) if " " not in text else text.lower().replace("ё", "е")
    # добавим пробелы вокруг пунктуации, чтобы токенизация ловила «в тбанк,»
    tokenised = re.sub(r"[^\w\s\-+]", " ", low, flags=re.UNICODE)

    # 1) Проверяем многословные алиасы (длиннее — приоритетнее).
    for alias, canon in _MULTIWORD_ALIASES:
        if alias in tokenised:
            return canon, 1.0

    # 2) Токенный матч.
    tokens = [t for t in re.split(r"[\s_]+", tokenised) if t]
    hits: list[tuple[str, float]] = []
    for tok in tokens:
        key = _norm_token(tok)
        canon = ALIASES.get(key)
        if canon:
            # длина ≥3 — уверенный матч, ≤2 — осторожный (т.к. «сб», «пб»
            # могут оказаться опечаткой или инициалом).
            score = 0.9 if len(key) >= 3 else 0.7
            hits.append((canon, score))
    if hits:
        # если несколько разных банков в одном сообщении — снижаем уверенность
        distinct = {c for c, _ in hits}
        best = max(hits, key=lambda p: p[1])
        if len(distinct) == 1:
            return best
        # неоднозначно — делим скор пополам
        return best[0], best[1] * 0.5

    # 3) Substring внутри слова (например «тинькофчик», «сберовский»):
    #    берём самый длинный матч.
    best_canon: Optional[str] = None
    best_len = 0
    for alias, canon in ALIASES.items():
        if len(alias) < 4:
            continue  # короткие substring'и слишком шумные
        if alias in tokenised:
            if len(alias) > best_len:
                best_len = len(alias)
                best_canon = canon
    if best_canon:
        return best_canon, 0.5

    return None, 0.0


# ──────────────────────────────────────────────────────────────────────────────
# 5. ПУБЛИЧНАЯ ФУНКЦИЯ detect(text)
# ──────────────────────────────────────────────────────────────────────────────
def detect(text: str) -> dict:
    """
    Главная функция модуля. Возвращает:
        {
            "bank":       str | None,  # каноническое название
            "amount":     int | None,  # целые рубли
            "name":       str | None,  # имя как во вводе
            "phone":      str | None,  # +7XXXXXXXXXX
            "confidence": float,       # 0..1, если < 0.5 — бот переспрашивает
        }
    """
    text = (text or "").strip()
    if not text:
        return {"bank": None, "amount": None, "name": None,
                "phone": None, "confidence": 0.0}

    # NFC-нормализация — на случай составных ё и т.п.
    text_norm = unicodedata.normalize("NFC", text)

    bank, bank_score = detect_bank(text_norm)
    amount = parse_amount(text_norm)
    phone = parse_phone(text_norm)
    name = parse_name(text_norm)

    # ── Скоринг ────────────────────────────────────────────────────────────
    # Весовые коэффициенты подобраны так, чтобы:
    #   * без банка — confidence не превышал 0.5 (бот будет переспрашивать);
    #   * банк (0.9) + сумма → 0.45 + 0.25 = 0.70 (уверенно);
    #   * банк (0.7, короткий) + сумма → 0.35 + 0.25 = 0.60 (уверенно);
    #   * только банк → 0.45 (переспрос);
    #   * только сумма → 0.25 (переспрос).
    w_bank = 0.5
    w_amount = 0.25
    w_name = 0.15
    w_phone = 0.10

    amount_score = 1.0 if amount is not None else 0.0
    name_score = 1.0 if name else 0.0
    phone_score = 1.0 if phone else 0.0

    confidence = (w_bank * bank_score
                  + w_amount * amount_score
                  + w_name * name_score
                  + w_phone * phone_score)
    confidence = round(min(1.0, max(0.0, confidence)), 3)

    return {
        "bank": bank,
        "amount": amount,
        "name": name,
        "phone": phone,
        "confidence": confidence,
    }


# ──────────────────────────────────────────────────────────────────────────────
# CLI для отладки: python bank_detector.py "перевод 2500 Пете в тбанк"
# ──────────────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    import sys, json
    q = " ".join(sys.argv[1:]) or "перевод 2500 Пете в тбанк"
    print(json.dumps(detect(q), ensure_ascii=False, indent=2))
