# Ребрендинги: после матча имени «Тинькофф» → возвращаем «Т-Банк».
_ALIAS_REMAP: dict[str, str] = {
    "Тинькофф": "Т-Банк",
}


def _norm_token(s: str) -> str:
    """Нормализация для сравнения: lowercase, ё→е, убираем точки/дефисы на краях."""
    s = s.lower().replace("ё", "е")
    s = s.strip(".,:;!?()[]{}«»\"'„”`~ ")
    return s


# Плоский словарь alias→canonical, подготовленный один раз на импорт модуля.
ALIASES: dict[str, str] = {}
for canon, variants in _RAW_ALIASES.items():
    target = _ALIAS_REMAP.get(canon, canon)
    for a in variants:
        key = _norm_token(a)
        if key:
            # Если алиас повторяется у разных банков (коллизия) — берём первый,
            # а второй логируем как неоднозначный (используется в detect_bank
            # как сигнал меньшего confidence).
            ALIASES.setdefault(key, target)


# Многословные алиасы (с пробелом/дефисом внутри) — для substring-поиска
# в произвольном тексте, где они могут встретиться подряд.
_MULTIWORD_ALIASES: list[tuple[str, str]] = sorted(
    ((_norm_token(a), _ALIAS_REMAP.get(canon, canon))
     for canon, variants in _RAW_ALIASES.items()
     for a in variants
     if " " in a or "-" in a.strip("-")),
    key=lambda p: -len(p[0]),  # длиннее — важнее (жадный матч)
)


# ──────────────────────────────────────────────────────────────────────────────
# 2. ПАРСЕР СУММЫ
# ──────────────────────────────────────────────────────────────────────────────
# Поддерживаемые формы:
#   «2500», «2 500», «2500 ₽», «2500руб», «2500 р.», «2500р», «2500RUB»,
#   «2.5к», «2,5к», «10к», «1.5к», «0.5млн», «1 000 000».
# Телефон (+7/8 10-11 цифр) НЕ должен путаться с суммой — его отфильтровываем
# заранее через parse_phone / _strip_phones.
_AMOUNT_UNIT_MULTIPLIERS = {
    "к": 1_000, "k": 1_000, "тыс": 1_000, "т": 1_000,
    "м": 1_000_000, "млн": 1_000_000, "кк": 1_000_000, "kk": 1_000_000,
    "ккк": 1_000_000_000, "млрд": 1_000_000_000,
}

_CURRENCY_HINT = r"(?:₽|руб(?:\.|лей|ля)?|р\.?(?![а-яё])|rub|rur)"

# Паттерн 1: число с опциональным суффиксом-множителем (2.5к, 10кк, 500тыс).
_RE_AMOUNT_UNIT = re.compile(
    r"(?<![\d.,])"              # слева не цифра/разделитель
    r"(\d{1,6}(?:[.,]\d{1,3})?)"  # 2 / 2.5 / 2,5 / 10 / 500
    r"\s*"
    r"(кк|ккк|k|kk|млн|млрд|тыс|к|т|м)"
    r"(?![а-яa-z\d])",            # справа не буква/цифра
    re.IGNORECASE,
)

# Паттерн 2: «денежное» число (есть валюта ИЛИ пробельные группы цифр).
_RE_AMOUNT_WITH_CUR = re.compile(
    r"(?<![\d.,])"
    r"(\d{1,3}(?:[ \u00a0]\d{3})+|\d{3,7})"  # 2 500 или 2500
    r"(?:[.,]\d{1,2})?"
    r"\s*" + _CURRENCY_HINT,
    re.IGNORECASE,
)

# Паттерн 3: просто «голое» число 2..7 цифр — самый слабый сигнал, используем
# последним, если ничего другого не нашли.
_RE_AMOUNT_BARE = re.compile(
    r"(?<![\d.,+])"
    r"(\d{1,3}(?:[ \u00a0]\d{3})+|\d{2,7})"
    r"(?![.,\d])",
)

_RE_PHONE = re.compile(
    r"(?<!\d)"
    r"(?:\+?7|8)[\s\-()]*"
    r"(?:\d[\s\-()]*){10}"
    r"(?!\d)"
)


def parse_phone(text: str) -> Optional[str]:
    """Возвращает телефон в формате +7XXXXXXXXXX, либо None."""
    m = _RE_PHONE.search(text)
    if not m:
        return None
    digits = re.sub(r"\D", "", m.group(0))
    if len(digits) == 11 and digits[0] in ("7", "8"):
        return "+7" + digits[1:]
    if len(digits) == 10:
        return "+7" + digits
    return None


def _strip_phones(text: str) -> str:
    """Убирает подстроки с телефонами — чтобы их цифры не ушли в amount."""
    return _RE_PHONE.sub(" ", text)


def parse_amount(text: str) -> Optional[int]:
    """
    Возвращает целое число рублей, либо None если в тексте не распознана сумма.
    Поддержка: 2500, 2 500, 2500₽, 2.5к, 2,5к, 10к, 0.5млн, 2500руб и т.д.
    """
    clean = _strip_phones(text)

    # 1) Сначала ищем «число + множитель» (2.5к, 10кк, 500тыс) — самый
    #    специфичный паттерн, никаких коллизий с датами/номерами карт.
    m = _RE_AMOUNT_UNIT.search(clean)
    if m:
        raw, unit = m.group(1), m.group(2).lower()
        value = float(raw.replace(",", ".").replace(" ", ""))
        mult = _AMOUNT_UNIT_MULTIPLIERS.get(unit)
        if mult:
            return int(round(value * mult))

    # 2) Число рядом с валютой («2500 ₽», «2500руб», «2 500 р.»).
    m = _RE_AMOUNT_WITH_CUR.search(clean)
    if m:
        raw = m.group(1).replace(" ", "").replace("\u00a0", "")
        if raw.isdigit():
            return int(raw)

    # 3) Голое число — берём самое «денежно-выглядящее»: предпочитаем те,
    #    что с пробельными группами (2 500), иначе самое длинное 3+ цифры.
    best: Optional[int] = None
    best_rank = -1
    for m in _RE_AMOUNT_BARE.finditer(clean):
        raw = m.group(1)
        has_group = " " in raw or "\u00a0" in raw
        digits = raw.replace(" ", "").replace("\u00a0", "")
        if not digits.isdigit():
            continue
        n = int(digits)
        # Исключаем номера карт/ячеек (слишком длинные) и явные id (1–9).
        if n < 10 or n > 10_000_000:
            continue
        # Ранг: группированные числа важнее, иначе длиннее — важнее.
        rank = (2 if has_group else 1) * 100 + len(digits)
        if rank > best_rank:
            best_rank = rank
            best = n
    return best


